# Simulator Environment Variables
# Copy this file to .env and fill in your values

# MQTT Broker connection
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulation settings
NUM_BIKES=10
NUM_DOCKS=4
TELEMETRY_INTERVAL_MS=4000   # How often each bike sends GPS (3000–5000ms)
DOCK_INTERVAL_MS=10000        # How often docks report status

# City center coordinates (default: Lagos Island, Nigeria)
CITY_LAT=6.4541
CITY_LNG=3.3792
CITY_RADIUS_KM=3              # Bikes roam within this radius
