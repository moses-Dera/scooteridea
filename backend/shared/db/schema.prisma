// Prisma Schema — E-Bike Sharing Platform (PostgreSQL + PostGIS)
// Run: npx prisma migrate dev

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// ── Users ──────────────────────────────────────────────────────────────────────
model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  name             String
  phone            String?
  pushToken        String?  @map("push_token") // Expo push token — set by client on login
  role             Role     @default(RIDER)
  walletCents      Int      @default(0) @map("wallet_cents")
  paystackAuthCode String?  @map("paystack_auth_code") // Tokenized card for auto-deduct
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  rides          Ride[]
  payments       Payment[]
  assignedZones  Geofence[]      @relation("UserAssignedZones")
  supportTickets SupportTicket[]

  @@map("users")
}

enum Role {
  RIDER
  OPERATOR
  ADMIN
}

// ── Bikes ──────────────────────────────────────────────────────────────────────
model Bike {
  id          String     @id
  status      BikeStatus @default(available)
  batteryPct  Int        @map("battery_pct")
  currentPin  String?    @map("current_pin") // 4-digit rolling PIN for hardware keypad access
  locationLat Float?     @map("location_lat")
  locationLng Float?     @map("location_lng")
  dockId      String?    @map("dock_id")
  lastSeen    DateTime?  @map("last_seen") @db.Timestamptz

  dock            Dock?            @relation(fields: [dockId], references: [id])
  rides           Ride[]
  zoneTransitions ZoneTransition[]

  @@map("bikes")
}

enum BikeStatus {
  available
  in_use
  charging
  maintenance
  offline
}

// ── Docking Stations ───────────────────────────────────────────────────────────
model Dock {
  id             String @id
  name           String
  locationLat    Float  @map("location_lat")
  locationLng    Float  @map("location_lng")
  totalSlots     Int    @default(0) @map("total_slots")
  availableSlots Int    @default(0) @map("available_slots")

  // Pricing overrides for this dock
  baseFareOverride  Int? @map("base_fare_override")
  perMinuteOverride Int? @map("per_minute_override")
  perKmOverride     Int? @map("per_km_override")

  bikes      Bike[]
  startRides Ride[] @relation("StartDock")
  endRides   Ride[] @relation("EndDock")

  @@map("docks")
}

// ── Rides ──────────────────────────────────────────────────────────────────────
model Ride {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  bikeId          String     @map("bike_id")
  startDockId     String?    @map("start_dock_id")
  endDockId       String?    @map("end_dock_id")
  status          RideStatus @default(RESERVED)
  startLat        Float?     @map("start_lat")
  startLng        Float?     @map("start_lng")
  endLat          Float?     @map("end_lat")
  endLng          Float?     @map("end_lng")
  startedAt       DateTime?  @map("started_at") @db.Timestamptz
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz
  fareCents       Int?       @map("fare_cents")
  distanceKm      Decimal?   @map("distance_km") @db.Decimal(6, 2)
  batteryStartPct Int?       @map("battery_start_pct")
  batteryUsedPct  Int?       @map("battery_used_pct") // Added for battery efficiency tracking
  routeGeometry   Json?      @map("route_geometry") // Added to permanently save ride trails
  surgeMult       Decimal    @default(1.0) @map("surge_mult") @db.Decimal(3, 2)

  // Locked pricing (prevents mid-ride pricing glitches if admin updates config)
  lockedBaseFareCents Int? @map("locked_base_fare_cents")
  lockedPerMinCents   Int? @map("locked_per_min_cents")
  lockedPerKmCents    Int? @map("locked_per_km_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id])
  bike      Bike      @relation(fields: [bikeId], references: [id])
  startDock Dock?     @relation("StartDock", fields: [startDockId], references: [id])
  endDock   Dock?     @relation("EndDock", fields: [endDockId], references: [id])
  payments  Payment[]

  @@index([userId])
  @@index([bikeId])
  @@map("rides")
}

enum RideStatus {
  RESERVED
  ACTIVE
  COMPLETING
  COMPLETED
  CANCELLED
}

// ── Payments ───────────────────────────────────────────────────────────────────
model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  rideId      String?       @map("ride_id") @db.Uuid
  amountCents Int           @map("amount_cents")
  currency    String        @default("NGN")
  status      PaymentStatus @default(pending)
  provider    String
  providerRef String?       @unique @map("provider_ref")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id])

  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

// ── Geofences ──────────────────────────────────────────────────────────────────
model Geofence {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  type     ZoneType
  speedCap Int?     @map("speed_cap")
  // Boundary stored as raw GeoJSON polygon string; index via PostGIS raw SQL
  boundary Json

  // Pricing overrides for this region
  baseFareOverride  Int? @map("base_fare_override")
  perMinuteOverride Int? @map("per_minute_override")
  perKmOverride     Int? @map("per_km_override")

  operators       User[]           @relation("UserAssignedZones")
  zoneTransitions ZoneTransition[]

  @@map("geofences")
}

enum ZoneType {
  operational
  slow
  no_ride
  dock
}

// ── Accountability & Logging ───────────────────────────────────────────────────
model ZoneTransition {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bikeId    String         @map("bike_id")
  zoneId    String         @map("zone_id") @db.Uuid
  type      TransitionType
  lat       Float
  lng       Float
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  bike Bike     @relation(fields: [bikeId], references: [id])
  zone Geofence @relation(fields: [zoneId], references: [id])

  @@map("zone_transitions")
}

enum TransitionType {
  ENTER
  EXIT
}

// ── System Configuration ───────────────────────────────────────────────────────
model SystemConfig {
  id                String   @id @default("global") // Single row pattern
  unlockFeeCents    Int      @default(5000) @map("unlock_fee_cents")
  perMinuteCents    Int      @default(2000) @map("per_minute_cents")
  perKmCents        Int      @default(3000) @map("per_km_cents")
  maxSurgeMult      Decimal  @default(2.5) @map("max_surge_mult") @db.Decimal(3, 2)
  outOfDockFeeCents Int      @default(50000) @map("out_of_dock_fee_cents")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_config")
}

// ── Customer Support ───────────────────────────────────────────────────────────
model SupportTicket {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("support_tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
