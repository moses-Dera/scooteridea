{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["typings/**/*", "index.ts", "errors/**/*", "logger/**/*", "middleware/**/*", "shutdown/**/*", "health/**/*", "resilience/**/*"],
  "exclude": ["node_modules", "dist"]
}
