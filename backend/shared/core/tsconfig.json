{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "typings/**/*",
    "index.ts",
    "errors/**/*",
    "logger/**/*",
    "middleware/**/*",
    "shutdown/**/*",
    "health/**/*",
    "resilience/**/*",
    "tracing/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
