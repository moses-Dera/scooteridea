{
  "name": "ebike-platform",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "backend/services/*",
    "backend/shared/*",
    "simulator",
    "frontend/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "dev": "node run-dev.js",
    "dev:turbo": "turbo run dev --parallel",
    "build": "turbo run build",
    "start:prod": "turbo run start --parallel",
    "test": "turbo run test",
    "docker:up": "docker compose -f backend/infra/docker-compose.yml up -d postgres redis emqx",
    "docker:down": "docker compose -f backend/infra/docker-compose.yml down",
    "docker:clean": "docker compose -f backend/infra/docker-compose.yml down -v"
  }
}
